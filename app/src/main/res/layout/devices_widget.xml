<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <FrameLayout android:layout_width="match_parent" android:layout_height="56dp" android:layout_gravity="center_vertical">
        <ImageView android:id="@+id/widget_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="Ajustes del widget"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp">
            <FrameLayout android:id="@+id/widget_device_1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp">
                <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="center">
                    <ImageView android:id="@+id/widget_progress_1" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no"/>
                    <ImageView android:id="@+id/widget_icon_1" android:layout_width="23dp" android:layout_height="23dp" android:layout_gravity="center" android:src="@drawable/ic_headphones" android:importantForAccessibility="no"/>
                </FrameLayout>
            </FrameLayout>
            <FrameLayout android:id="@+id/widget_device_2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp">
                <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="center">
                    <ImageView android:id="@+id/widget_progress_2" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no"/>
                    <ImageView android:id="@+id/widget_icon_2" android:layout_width="23dp" android:layout_height="23dp" android:layout_gravity="center" android:src="@drawable/ic_headphones" android:importantForAccessibility="no"/>
                </FrameLayout>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
