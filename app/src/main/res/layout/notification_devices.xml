<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Dispositivos · salida de audio" android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" android:maxLines="1" />
  <LinearLayout android:id="@+id/notification_row_1" android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:orientation="horizontal">
    <ImageView android:id="@+id/notification_icon_1" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginEnd="8dp" android:importantForAccessibility="no" />
