        <TextView android:id="@+id/notification_plus_1" android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="+" android:textSize="24sp" android:textAppearance="@android:style/TextAppearance.Material.Notification" android:background="?android:attr/selectableItemBackground" />
      </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="80dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
      <ImageButton android:id="@+id/notification_check_1" android:layout_width="56dp" android:layout_height="40dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:scaleType="center" android:src="@drawable/ic_checkbox_unknown" />
      <TextView android:id="@+id/notification_state_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1" android:textSize="10sp" android:textAppearance="@android:style/TextAppearance.Material.Notification" />
    </LinearLayout>
  </LinearLayout>
  <LinearLayout android:id="@+id/notification_row_2" android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:orientation="horizontal">
    <ImageView android:id="@+id/notification_icon_2" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginEnd="8dp" android:importantForAccessibility="no" />
